{
  "general": {
    "startup_with_system": false,
    "minimize_to_tray": true,
    "save_history": false,
    "history_dir": ""
  },
  "appearance": {
    "schema_version": 1,
    "palette": "warm_paper",
    "accent": "#2878E8",
    "motion_profile": "flow",
    "density": "balanced",
    "surface": "layered",
    "reduce_motion": false
  },
  "capture": {
    "select_mask_opacity": 84
  },
  "ocr": {
    "engine": "rapidocr",
    "lang": "auto",
    "min_confidence": 0.6,
    "merge_y_tolerance_ratio": 0.3,
    "merge_x_gap_ratio": 0.8,
    "rapidocr": {
      "limit_side_len": 960,
      "threads": 0,
      "upscale_below": 240,
      "max_upscale": 2.0
    }
  },
  "translation": {
    "service": "offline",
    "source_language": "auto",
    "target_language": "zh-hant",
    "keep_original": false,
    "use_context": true,
    "context_size": 2,
    "lyrics_mode": false,
    "skip_sounds": true,
    "retry_non_chinese": true,
    "offline": {
      "model_name": "auto",
      "model_dir": "",
      "gpu_layers": -1,
      "threads": 0
    },
    "timeout_seconds": 30,
    "max_retries": 3,
    "retry_delay_seconds": 1.0,
    "request_interval_seconds": 0.0,
    "cache_ttl_days": 30,
    "cache_max_entries": 2000
  },
  "overlay": {
    "background_color": "#000000",
    "auto_background": true,
    "background_alpha": 160,
    "font_family": "",
    "font_size": 18,
    "text_color": "#FFFFFF",
    "use_auto_text_color": true,
    "padding": 4,
    "border_radius": 4,
    "border_color": "#FFFFFF",
    "border_alpha": 60,
    "show_border": true,
    "min_font_size": 8
  },
  "output": {
    "enabled": true,
    "directory": "",
    "min_seconds": 0.3
  },
  "hotkeys": {
    "capture_region": "ctrl+shift+a",
    "capture_fullscreen": "ctrl+shift+f",
    "capture_window": "ctrl+shift+w",
    "toggle_overlay": "ctrl+shift+h",
    "refresh": "ctrl+shift+r"
  }
}
